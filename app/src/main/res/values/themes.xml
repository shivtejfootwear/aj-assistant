<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AJ" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/cyan</item>
        <item name="colorPrimaryVariant">@color/cyan_dim</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorSecondary">@color/cyan</item>
        <item name="colorOnSecondary">@color/bg</item>
        <item name="colorSurface">#0C1528</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorControlNormal">@color/text_dim</item>
        <item name="colorControlActivated">@color/cyan</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="materialButtonStyle">@style/AJ.Button</item>
        <item name="alertDialogTheme">@style/AJ.Dialog</item>
        <item name="materialAlertDialogTheme">@style/AJ.Dialog</item>
    </style>

    <!-- चमकदार, गोल कोनों वाले HUD बटन -->
    <style name="AJ.Button" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/cyan_soft</item>
        <item name="android:textColor">@color/cyan</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="AJ.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/cyan</item>
        <item name="colorSurface">#0E1A30</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
    </style>
</resources>
